{
  "name": "@arcane/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@arcane/auth": "workspace:*",
    "@arcane/config": "workspace:*",
    "@arcane/connector-runtime": "workspace:*",
    "@arcane/core": "workspace:*",
    "@arcane/nats-client": "workspace:*",
    "@arcane/policy": "workspace:*",
    "@arcane/schemas": "workspace:*",
    "@arcane/search": "workspace:*",
    "@arcane/telemetry": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.0.1",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "nats": "^2.28.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
