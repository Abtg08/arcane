# Normalize line endings to LF in the repo, checkout as LF on all platforms
* text=auto eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.sh text eol=lf

# Binaries
*.png binary
*.jpg binary
*.ico binary
*.pack binary
