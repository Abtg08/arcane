# ═══════════════════════════════════════════════════════════════
# Arcane — Environment Variables
# Copy this to .env and fill in values. NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://arcane:arcane@localhost:5432/arcane
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Valkey (Redis-compatible) — ephemeral state only ──────────
VALKEY_URL=redis://localhost:6379

# ─── NATS JetStream — async messaging ──────────────────────────
NATS_URL=nats://localhost:4222

# ─── S3-compatible object storage (MinIO in dev) ───────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=arcane-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ─── OpenTelemetry ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=arcane-api

# ─── Secrets / Envelope Encryption ────────────────────────────
# 32-byte hex master key — generate with: openssl rand -hex 32
# NEVER reuse across environments. Rotate with key versioning.
SECRET_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_OPENSSL_RAND_HEX_32
SECRET_BACKEND=local  # local | aws-kms | gcp-kms | openbao

# KMS_KEY_ID only required when SECRET_BACKEND != local
# KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/...

# ─── API Service ───────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h

API_KEY_PREFIX=arc_
OAUTH_REDIRECT_BASE_URL=http://localhost:3001

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Rate limits (requests per minute)
RATE_LIMIT_GLOBAL_RPM=1000
RATE_LIMIT_PER_KEY_RPM=100

# ─── MCP Gateway ───────────────────────────────────────────────
MCP_PORT=3002
EXECUTION_GATEWAY_URL=http://localhost:3001

# ─── Webhook Ingress ───────────────────────────────────────────
WEBHOOK_PORT=3003
MAX_PAYLOAD_BYTES=1048576

# ─── Node environment ──────────────────────────────────────────
NODE_ENV=development
