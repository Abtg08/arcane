{
  "name": "arcane",
  "version": "0.0.1",
  "private": true,
  "description": "Capability execution layer for AI agents",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:security": "pnpm -r test:security",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,yaml,yml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,yaml,yml,md}\"",
    "db:migrate": "tsx packages/core/src/db/migrate.ts",
    "db:migrate:create": "node -e \"require('fs').writeFileSync('migrations/' + String(Date.now()) + '_' + process.argv[1] + '.sql', '-- Migration: ' + process.argv[1])\"",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "pnpm db:migrate && pnpm db:seed",
    "infra:up": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f",
    "infra:core": "docker compose -f infra/docker/docker-compose.dev.core.yml up -d",
    "infra:core:down": "docker compose -f infra/docker/docker-compose.dev.core.yml down"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
